            -R /courses/BINF6610.202710/data/refs/grch38-1000g/GRCh38_full_analysis_set_plus_decoy_hla.fa \
            -V gendb://${LOCAL_DB}/gendb \
            -O work/genotype/cohort.vcf.gz \
            --tmp-dir ${LOCAL_DB}

        rm -rf ${LOCAL_DB}) 2> logs/joint_genotype.log
        
